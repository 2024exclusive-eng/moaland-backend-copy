# Set feature on only after migrations 010, 011 and 012.
NOTIFICATIONS_ENABLED=false
# Do not enable before explicit owner approval.
NOTIFICATION_SEND_ENABLED=false
# Optional absolute JSON file path; bundled config/notification-templates.json is default.
WX_NOTIFICATION_TEMPLATES_FILE=
# Optional JSON override (takes precedence); do not set an empty object unintentionally.
# WX_NOTIFICATION_TEMPLATES=
NOTIFICATION_REVIEW_BASIS=scheduled
